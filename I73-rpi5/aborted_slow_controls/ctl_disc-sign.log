== 4. The entries in closed form, and the time lemma ==
  Tx = -alpha*c*f1 + u*v*(c**2*f2 + f1*s**2/r)
  Tr = -alpha*f1*s + c*s*u*v*(-f1/r + f2)
  A = v**2*(2*f*(c**2*f2*r + f1*s**2) + f1**2*r*(c**2 + 1))/(2*r)
  B = c*s*v**2*(-f*f1 + f*f2*r + 2*f1**2*r)/(2*r)
  q = f1**2*s**2*v**2
  j1 = v*(f1*(c**2 + 1) + f2*r*s**2)/(2*r)
  jr = c*s*v*(f1 - f2*r)/(2*r)
  dTx = (-alpha*c*f1*r + c**2*f2*r*u*v - c**2*f2*r*v**2 + f1*s**2*u*v - f1*s**2*v**2)/r
