short = 0;
ring R = 0,(s,u0,u1,u2,u3,u4),dp;
option(redSB);
ideal I = 3*s*u1*u2-7*s-7*u0^2+8*u0*u1-9*u1^2-8*u1*u2+4,
  -s^3-3*s*u0*u2-s*u1^2-3*s*u1*u2-9*u0^2*u1-u1*u2^2-4*u1+5,
  -4*s*u0*u1+7*s*u1*u2-s*u2^2-2*s+3*u0^3+6*u0*u2-2*u1*u2^2+2,
  4*s^2*u1+4*s*u0^2+7*s+4*u0^3+5*u0-3*u2+3,
  7*s*u0*u2+8*s*u0+5*s-u0^2*u2-8*u0*u1^2+u2^3+6*u2^2+3;

int t0 = rtimer;
matrix T;
ideal G = liftstd(I, T);
print("LIFTSTD_SECONDS " + string(rtimer - t0));
print("G1 " + string(G[1]) + " size " + string(size(G)));
poly chk = 0;
int i;
for (i = 1; i <= ncols(I); i++) { chk = chk + I[i] * T[i, 1]; }
print("KAPPA " + string(chk));
for (i = 1; i <= ncols(I); i++) { print("TERMS " + string(i) + " " + string(size(T[i, 1]))); }
for (i = 1; i <= ncols(I); i++) { print("COF " + string(i) + " " + string(T[i, 1])); }
quit;
