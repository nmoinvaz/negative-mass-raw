short = 0;
ring R = 0,(s,u0,u1,u2,u3,u4),dp;
option(redSB);
ideal I = 3*u0^3-6*u0^2*u1+5*u0*u1-3*u0+6*u1^3+8,
  9*s^3-2*s*u0*u1-s*u0-6*s*u1^2+5*u1+6,
  -3*s^3+4*s^2*u0-9*s^2*u1+7*s*u0^2+3*u1+4,
  5*s^2-2*s*u0^2-9*s*u1^2+4*u0+9;

int t0 = rtimer;
matrix T;
ideal G = liftstd(I, T);
print("LIFTSTD_SECONDS " + string(rtimer - t0));
print("G1 " + string(G[1]) + " size " + string(size(G)));
poly chk = 0;
int i;
for (i = 1; i <= ncols(I); i++) { chk = chk + I[i] * T[i, 1]; }
print("KAPPA " + string(chk));
for (i = 1; i <= ncols(I); i++) { print("TERMS " + string(i) + " " + string(size(T[i, 1]))); }
for (i = 1; i <= ncols(I); i++) { print("COF " + string(i) + " " + string(T[i, 1])); }
quit;
